# Copy to .env and fill in real values. NEVER commit the filled-in .env.
# Generate a ready-to-use .env from .credential.txt with:
#   ./scripts/gen-env.sh

# --- Admin awal (dipakai `npm run seed --workspace apps/api`) ---
# Kalau kosong, seed membuat password acak dan mencetaknya sekali di log.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-strong

# --- Database (PostgreSQL 15 on container "postgres-15") ---
DB_HOST=postgres-15
DB_PORT=5432
DB_NAME=grade6_db
DB_USER=grade6_user
DB_PASSWORD=change-me

# --- Domain yang diizinkan (CORS) ---
# Comma-separated, tanpa trailing slash. Aplikasi dilayani satu origin lewat
# docker/proxy.js, jadi daftar ini hanya untuk klien lintas-origin.
ALLOWED_ORIGINS=https://bilmary.my.id

# --- Zona waktu ---
# Semua tanggal & waktu (notifikasi Telegram, laporan PDF/Excel) memakai zona ini.
APP_TIMEZONE=Asia/Jakarta

# --- Ports ---
API_PORT=3001
WEB_PORT=3000

# --- Auth ---
# Dibuat otomatis oleh scripts/gen-env.sh (random 48 byte, base64url).
# Mengganti nilai ini akan logout semua sesi admin yang sedang aktif.
JWT_SECRET=change-me
# Umur token sesi = batas idle admin (menit).
# Sesi yang aktif diperpanjang otomatis setiap ada aktivitas, jadi ini bukan
# batas total waktu login. Diam lebih dari ini -> auto logout ke /gema/login.
SESSION_IDLE_MINUTES=5

# --- Throttle (rate limit) ---
# Batas global seluruh endpoint - harus longgar, kalau tidak dashboard ikut terkunci
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=60000
# Batas ketat khusus endpoint POST /api/auth/login
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000

# --- Upload bukti transaksi ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# --- Kredensial Telegram SENGAJA TIDAK ADA DI SINI ---
# Sumbernya tabel `settings`: telegram.botToken & telegram.chatId
# Isi / refresh: ./scripts/sync-telegram-settings.sh
